# Raw API dumps and cached pipeline outputs — never commit vendor/commenter data
runs/

# Harness output (predictions JSON, baseline reports) - regenerated by eval/harness.py
report/

# Stage 6 sync snapshots — rolling "previous run" cache, overwritten every
# sync by design (see FINDINGS.md); regenerable from the golden set + a live
# Graph API pull, never a source of truth
data/snapshots/

# Golden set - hand-labeled vendor data: real captions, commenter handles,
# comment text, and product photos. Never committed. NOTE: the hand labels
# are not regenerable from make_golden_skeleton.py - keep a backup outside
# this repo, git is no longer protecting them.
eval/golden/

# Secrets
.env
*.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/

.vscode/

# Scratch/working files - local only
scratch_*.txt
scratch_*.json
*.bak
