# Copy to .env and fill in. .env is gitignored and must stay that way -
# `make check-secrets` / the pre-commit hook (see scripts/scan_secrets.py)
# refuses a commit that stages it.
#
# NEVER put real values in this file. Keys only, empty values.
# pipeline/settings.py is the only place load_dotenv() runs; everything
# resolves through it.

# --- Instagram Graph API --------------------------------------------------
# One entry per connected Professional/tester account. --token-env selects
# which one a run uses, so a second vendor never overwrites the first
# (ingest.py, scripts/run_stage6.py, scripts/refresh_media_urls.py).
IG_ACCESS_TOKEN=
IG_ACCESS_TOKEN_GADGETS=

# --- Model providers ------------------------------------------------------
# Which of these you need depends on the experiment YAML you run; the model
# strings in pipeline/config/experiments/*.yaml name the provider prefix
# (gemini/..., groq/..., openrouter/...) and litellm resolves the key.
#
# GEMINI_API_KEY is the default cascade's key (default.yaml) AND the key
# pipeline/media_fingerprint.py uses for Stage 6 caption embeddings.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Minimum seconds between provider calls (pipeline/llm_client.py::throttle).
# Unset defaults to 4.5, which keeps a run under Gemini's free-tier ceiling of
# 15 requests/minute/model. Without it a run bursts past the limit, the 429s are
# absorbed by the retry loop, and Stage 3 silently falls back to its regex
# heuristic. Set to 0 on a paid tier.
LLM_MIN_CALL_INTERVAL=

# --- DVC remote (Cloudflare R2) -------------------------------------------
# Read once by `make dvc-setup` (scripts/setup_dvc_remote.py), which writes
# them into .dvc/config.local - itself gitignored.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
